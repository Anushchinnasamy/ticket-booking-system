# Copy this file to .env (already gitignored) and fill in real values before
# running `docker compose up`. Every value here has a safe default baked
# into docker-compose.yml, so the stack still starts without a .env file —
# Razorpay checkout and outgoing email just won't work until these are set.

# Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail App Password (not your real password) for outgoing notification email
# https://myaccount.google.com/apppasswords
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# MinIO (ticket PDF storage) — fine to leave as the defaults for local use
MINIO_ACCESS_KEY=ticketbooking
MINIO_SECRET_KEY=ticketbooking123

# Where the frontend container is reachable from a browser, and where the
# frontend should send API calls — override if you're not using the default
# port mappings below.
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080
